# Copy this into DigitalOcean App Platform's "Environment Variables" panel
# for the web service (App Platform doesn't read .env files from the repo —
# it injects these as real container env vars). Mark anything with a secret
# value as "Encrypted" in the dashboard. See DEPLOYMENT.md for the full walkthrough.
#
# Replace yourdomain.com below with your real domain everywhere it appears.
# One domain serves both the web app and the API (Laravel serves the Vue
# SPA itself), so APP_URL is the public domain — not an "api." subdomain.

APP_NAME="Altar Place"
APP_ENV=production
APP_KEY=                          # generate with: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://yourdomain.com
# Only used for links sent to the *mobile* app (see App\Support\FrontendUrl);
# web requests use APP_URL. Point at wherever the mobile app's links resolve.
FRONTEND_URL=https://yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# --- Database: create a Managed MySQL cluster (or an App Platform "Dev
# Database" to start cheaper) and paste its connection details here. ---
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=25060
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# Hosts (no scheme) the web app is served from — Sanctum only issues cookie
# sessions to requests whose Origin/Referer host is listed. Setting this
# REPLACES Sanctum's defaults, so include every host you browse the app on
# (e.g. the temporary *.ondigitalocean.app URL as well as your real domain).
SANCTUM_STATEFUL_DOMAINS=yourdomain.com

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- File storage: covers/avatars/ad-creatives AND audio+HLS both move to
# DO Spaces so nothing is lost when the container redeploys (App Platform has
# no persistent disk). See config/filesystems.php. ---
FILESYSTEM_DISK_PUBLIC=s3
FILESYSTEM_DISK_AUDIO=s3
AWS_ACCESS_KEY_ID=                # Spaces access key
AWS_SECRET_ACCESS_KEY=            # Spaces secret key
AWS_DEFAULT_REGION=nyc3           # whichever Spaces region you created
AWS_BUCKET=                       # your Spaces bucket name
AWS_ENDPOINT=https://nyc3.digitaloceanspaces.com
AWS_URL=https://your-bucket.nyc3.cdn.digitaloceanspaces.com
AWS_USE_PATH_STYLE_ENDPOINT=false

FFMPEG_PATH=ffmpeg                # already on PATH in the Docker image

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/auth/social/google/callback

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=https://yourdomain.com/api/auth/social/facebook/callback

# Leave true until you're actually ready to take real payments — every
# provider resolves to an instantly-successful fake gateway while true.
PAYMENT_TESTING_MODE=true
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
